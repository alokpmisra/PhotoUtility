// EduPlatform data model
// Core idea: students progress through mastery-gated Skills (Kumon-style
// sequential unlocking) while an adaptive engine (see src/lib/masteryEngine.ts)
// continuously re-targets question difficulty per student per skill.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  // Self-relation: a PARENT/TUTOR user can be linked to one or more STUDENT users
  guardianOf User[] @relation("Guardianship")
  guardians  User[] @relation("Guardianship")

  studentProfile StudentProfile?
  attempts       Attempt[]
  masteries      SkillMastery[]
  earnedBadges   EarnedBadge[]
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeBand String // e.g. "K-2", "3-5", "6-8"
  createdAt DateTime @default(now())
}

model Subject {
  id    String @id @default(cuid())
  slug  String @unique // "math" | "reading" | "science"
  name  String
  color String // UI accent color
  icon  String // emoji / icon key
  order Int    @default(0)
  units Unit[]
}

model Unit {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  gradeBand String
  order     Int     @default(0)
  skills    Skill[]

  @@unique([subjectId, slug])
}

model Skill {
  id          String @id @default(cuid())
  unitId      String
  unit        Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  order       Int    @default(0)

  // Mastery-gate: prerequisite skills that must be mastered before this
  // skill unlocks (Kumon-style sequential progression).
  prerequisites Skill[] @relation("SkillPrereqs")
  unlocks       Skill[] @relation("SkillPrereqs")

  questions Question[]
  masteries SkillMastery[]

  @@unique([unitId, slug])
}

enum QuestionType {
  MULTIPLE_CHOICE
  NUMERIC
  SHORT_TEXT
}

model Question {
  id          String       @id @default(cuid())
  skillId     String
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type        QuestionType
  difficulty  Int // 1 (easiest) .. 5 (hardest)
  prompt      String
  choices     String? // JSON-encoded string[] for MULTIPLE_CHOICE
  answer      String // canonical correct answer (string form)
  explanation String // shown after attempt, regardless of correctness
  hint        String? // optional scaffold shown after a wrong attempt
  createdAt   DateTime     @default(now())

  attempts Attempt[]
}

model Attempt {
  id                  String   @id @default(cuid())
  studentId           String
  student             User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId          String
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  givenAnswer         String
  correct             Boolean
  responseTimeMs      Int
  difficultyAtAttempt Int
  masteryBefore       Float
  masteryAfter        Float
  createdAt           DateTime @default(now())
}

model SkillMastery {
  id                  String    @id @default(cuid())
  studentId           String
  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  masteryScore        Float     @default(0) // 0-100
  currentDifficulty   Int       @default(1) // 1-5, adaptively targeted
  correctStreak       Int       @default(0)
  topDifficultyStreak Int       @default(0) // consecutive correct at difficulty 5 -> unlock gate
  attemptsCount       Int       @default(0)
  masteredAt          DateTime?
  lastPracticedAt     DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([studentId, skillId])
}

model Badge {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String
  earnedBy    EarnedBadge[]
}

model EarnedBadge {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
}
